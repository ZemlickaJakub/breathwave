    },
    "Breathwave is free and ad-free. Tips support development and unlock nothing." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathwave je zdarma a bez reklam. Příspěvky podporují vývoj a nic neodemykají."
          }
        }
      }
    },
    "Breathwave was vibecoded: Jakub built it with his AI agent — no team of developers, no investor. It is free, has no ads and collects no data." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathwave vznikl vibecodingem: postavil jsem ho se svým AI agentem — bez týmu vývojářů, bez investora. Je zdarma, bez reklam a nesbírá žádná data."
          }
        }
      }
    },
    "Completed sessions are saved to Apple Health as Mindful Minutes. Breathwave never reads any Health data." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokončená cvičení se ukládají do Apple Zdraví jako minuty mindfulness. Breathwave žádná data ze Zdraví nečte."
          }
        }
      }
    },
