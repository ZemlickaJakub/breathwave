    "About" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplikaci"
          }
        }
      }
    },
    "Breathe with the wave" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dýchej s vlnou"
          }
        }
      }
    },
    "Breathwave is free and ad-free. Tips support development and unlock nothing." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathwave je zdarma a bez reklam. Příspěvky podporují vývoj a nic neodemykají."
          }
        }
      }
    },
    "Breathwave was built in 14 days by Jakub and his AI agent — no team of developers. It is free, has no ads and collects no data." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathwave jsem postavil za 14 dní se svým AI agentem. Bez týmu vývojářů. Je zdarma, bez reklam a nesbírá žádná data."
          }
        }
      }
    },
    "Completed sessions are saved to Apple Health as Mindful Minutes. Breathwave never reads any Health data." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokončená cvičení se ukládají do Apple Zdraví jako minuty mindfulness. Breathwave žádná data ze Zdraví nečte."
          }
        }
      }
    },
