    "Your soul knows the way": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje duše ví cestu"
          }
        }
      }
    },
    "meditation.description": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ticho — nebo oceán — a na závěr jemné cinknutí. Prostě seď a pozoruj; o zbytek se postará časovač. Volitelné intervalové zvonky ti jemně připomenou, kolik času uběhlo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silence — or the ocean — with a gentle chime to close. Just sit and observe; the timer takes care of the rest. Optional interval bells gently mark the passing time."
          }
        }
      }
    },
    "meditation.when": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdykoli si chceš sednout beze slov a bez vedení — od pěti minut po hodinu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whenever you want to sit without words or guidance — from five minutes to an hour."
          }
        }
      }
    },
    "protocol.box.description": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtyři stejné fáze: nádech, zádrž, výdech, zádrž. Rytmus pro soustředění a klidnou hlavu. Oblíbený u sportovců a potápěčů."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four equal parts: breathe in, hold, breathe out, hold. A steadying rhythm for focus and a clear head. A favorite of athletes and divers."
          }
        }
      }
    },
    "protocol.box.when": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před prezentací, těžkým rozhovorem nebo startem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before a presentation, a hard conversation or a start line."
          }
        }
      }
    },
    "protocol.coherent.description": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomalý, vyrovnaný rytmus — zhruba pět a půl sekundy nádech, pět a půl výdech. Tělo se při něm přirozeně usadí do klidu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A slow, even rhythm — about five and a half seconds in, five and a half out. Breathing this way lets the body settle into its natural calm."
          }
        }
      }
    },
    "protocol.coherent.when": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skvělý základ na každý den — ráno, o pauze i večer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A great everyday default — mornings, breaks and evenings."
          }
        }
      }
    },
    "protocol.custom.description": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav si délku všech čtyř fází po svém — nádech, zádrž, výdech, zádrž. Rytmus, který ti sedí, je ten, u kterého vydržíš."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the length of all four phases yourself — inhale, hold, exhale, hold. The rhythm that suits you is the one you can stay with."
          }
        }
      }
    },
    "protocol.custom.when": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když už víš, co ti funguje — nebo chceš experimentovat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you already know what works for you — or want to experiment."
          }
        }
      }
    },
    "protocol.extended-exhale.description": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je výdech delší než nádech, tělo to čte jako signál, že se může uvolnit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the exhale is longer than the inhale, the body reads it as a signal that it is safe to relax."
          }
        }
      }
    },
    "protocol.extended-exhale.when": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlý reset ve stresových chvílích — kdekoli, kdykoli."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick reset for stressful moments — anywhere, anytime."
          }
        }
      }
    },
    "protocol.four-seven-eight.description": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nádech na čtyři, zádrž na sedm, výdech na osm. Dlouhá zádrž a ještě delší výdech všechno zpomalí."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe in for four, hold for seven, let go for eight. The long hold and even longer exhale slow everything down."
          }
        }
      }
    },
    "protocol.four-seven-eight.when": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejlepší večer nebo v posteli, když se hlava nechce zastavit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best in the evening or in bed when thoughts won't stop."
          }
        }
      }
    },
    "protocol.om.description": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhluboka se nadechni a celý výdech nech nést dlouhé „óóóm“. Jemná vibrace vlastního hlasu spolu s prodlouženým výdechem podporuje přirozené zklidnění — bývá spojována s bloudivým nervem (vagus). Laď se podle tónu, který hraje při výdechu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe in deeply, then let a long voiced “om” carry the whole exhale. The gentle vibration of your own voice and the extended exhale support natural calm — often associated with the vagus nerve. Tune your hum to the tone that plays during the exhale."
          }
        }
      }
    },
    "protocol.om.when": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdykoli chceš hluboké uvolnění — a nevadí ti, že jsi u toho slyšet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whenever you want deep release — and don't mind being heard."
          }
        }
      }
    }
  },
  "version": "1.0"
}