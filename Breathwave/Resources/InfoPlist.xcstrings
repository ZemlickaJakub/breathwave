      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathwave do Apple Zdraví pouze zapisuje dokončená cvičení a žádná tvoje zdravotní data nečte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathwave only writes your completed sessions to Apple Health and does not read any of your health data."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathwave může ukládat dokončená dechová cvičení a meditace do Apple Zdraví jako minuty mindfulness. Je to volitelné."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathwave can save your completed breathing and meditation sessions to Apple Health as Mindful Minutes. This is optional."
          }
        }
      }
